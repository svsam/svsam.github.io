# Local environment files and credentials
.env
.env.*
!.env.example
!.env.*.example
.dev.vars
.dev.vars.*
secrets/
*.pem
*.key
*.p12
*.pfx
*.jks

# Local-only configuration (the public example remains tracked)
deployment/public-config.local.js

# Dependency, tool, and test output
node_modules/
.wrangler/
.cache/
coverage/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor and operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
*.swp
*.swo

# Private operating workspace — never add these folders to the public website
/artifacts/
/dashboard/
/exports/
/ops/
/research/

# Deliberately not ignored: site/, site/CNAME, .github/, deployment/, api/,
# reviewed tools and other files required by the public GitHub Pages source.
# .gitignore does not untrack existing files; inspect `git ls-files` before push.
